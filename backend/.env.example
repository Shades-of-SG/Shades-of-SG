PORT=5000
NODE_ENV=development

# Supabase PostgreSQL
# Leave DATABASE_URL commented for local SQLite development.
# Uncomment and fill this only when connecting to Supabase/PostgreSQL.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres
DB_SSL=true
SEQUELIZE_LOGGING=false

# Local SQLite fallback, used only when DATABASE_URL is not set
DB_STORAGE=./database.sqlite

# Auth and media providers
# Either auth variable is accepted; set one strong, unique value in production.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
# Auth bearer tokens expire after one hour by default (minimum 300, maximum 86400).
AUTH_TOKEN_TTL_SECONDS=3600
# Separate secret used to pseudonymise OTP-request IP addresses in the database.
OTP_IP_HASH_SECRET=replace-with-another-long-random-secret
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional origins, such as approved Vercel preview domains.
FRONTEND_URLS=
# Optional one-time operational bootstrap for the first platform administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Administrator

# SMTP email delivery. Gmail supports port 465 with SMTP_SECURE=true or
# port 587 with SMTP_SECURE=false (STARTTLS). Use a Gmail App Password, never
# a normal account password. MAIL_TRANSPORT=json is for local development only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Bounds DNS, connection, TLS greeting, and socket waits (1,000-25,000 ms).
SMTP_TIMEOUT_MS=10000
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Shades of SG <no-reply@example.com>
MAIL_TRANSPORT=

# Google Identity Services web client ID. Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=

# Sign in with Apple web configuration. All values are required to enable it.
# APPLE_CLIENT_ID is the Services ID and APPLE_REDIRECT_URI must exactly match
# the HTTPS return URL registered with Apple. Escape private-key newlines as \\n.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Temporary fallback while final AI MP4 generation is incomplete.
# Use an absolute, publicly reachable URL in deployed environments. Completed jobs label it temporary.
PLACEHOLDER_VIDEO_URL=

# AI transcription
OPENAI_API_KEY=
# Whisper is required when scene generation needs segment timestamps.
# GPT-4o transcription models are also accepted, but return lyrics without segments.
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional YouTube audio extraction
# Leave blank if yt-dlp is available on PATH, or set to a local executable path.
YT_DLP_PATH=
