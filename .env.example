# Copy backend/.env.example to backend/.env and frontend/.env.example to frontend/.env.
# This root example only documents the shared local defaults.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
VITE_API_URL=/api
# Optional one-time operational bootstrap for the first platform administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Administrator
